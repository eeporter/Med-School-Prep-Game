{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "package.json",
      "LICENSE",
      "**/.*",
      "**/*.md",
      "**/node_modules/**",
      "docs/**",
      "study-guides/**",
      "scripts/**",
      "test/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
